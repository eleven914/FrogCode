# FrogCode 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
FROG_HOST=127.0.0.1
FROG_PORT=7437

# ── Logging ───────────────────────────────────────────────────
FROG_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
FROG_LOG_FILE=~/.frog/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
FROG_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# FROG_CONFIG=~/.frog/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# FROG_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# Anthropic 官方接口可留空；DeepSeek Anthropic 兼容接口填 https://api.deepseek.com/anthropic
# FROG_LLM_BASE_URL=
# FROG_MAX_STEPS=20
